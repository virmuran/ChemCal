# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

# ── PyInstaller 构建输出 ──
build/
dist/
installer/

# ── 虚拟环境 ──
venv/
.venv/
env/
ENV/
.conda/

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace

# ── 系统 ──
.DS_Store
Thumbs.db
desktop.ini

# ── 可执行文件 ──
*.exe
*.msi

# ── PyInstaller 归档（PYZ 打包中间产物，验证时会在根目录生成）──
*.pyz

# ── 用户运行时数据 ──
.ChemCal/
ChemCal_data.json
*.log

# ── WorkBuddy 工作目录（调试脚本/截图/测试报告，非源码）──
.workbuddy/

# ── 发版说明草稿（一次性产物：只用来粘进 GitHub Releases 正文，不属仓库内容；
#    版本记录的唯一来源是 README.md 的「更新日志」）──
RELEASE_NOTES_v*.md

# ── 临时文件 ──
*.tmp
*.bak
*.bak[0-9]
*.bak[0-9][0-9]
*.orig

# ── 测试运行报告（run_all.py 每次覆盖，非源码）──
tests/_last_run.txt
tests/_tmp_fire/
